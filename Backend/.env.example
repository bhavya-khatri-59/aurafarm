# Copy to Backend/.env and fill in.

# Required: https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq model with tool calling, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile
ORCHESTRATOR_MODEL=openai/gpt-oss-120b
REMEDY_MODEL=openai/gpt-oss-120b

# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-in-production

# Weather context: https://www.weatherapi.com/ (free tier is enough)
WEATHER_API_KEY=

# Optional: better web search for the remedy agent (https://tavily.com). DuckDuckGo is used otherwise.
TAVILY_API_KEY=

# Optional tuning
# CONFIDENCE_THRESHOLD=0.6
# OUTBREAK_RADIUS_KM=10
# OUTBREAK_WINDOW_DAYS=14
# PLACES_RADIUS_KM=15
